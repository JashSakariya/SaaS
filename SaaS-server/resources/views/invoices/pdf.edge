<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invoice - {{ invoice.invoiceNumber || 'Draft' }}</title>
  <style>
    @page {
      size: A4 portrait;
      margin: 15mm 15mm 20mm 15mm;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #111827;
      background: #ffffff;
      font-size: 13px;
      line-height: 1.5;
      padding: 20px;
    }

    /* Container */
    .invoice-container {
      max-width: 800px;
      margin: 0 auto;
    }

    /* Header */
    .invoice-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 20px;
    }

    .brand-section {
      max-width: 60%;
    }

    .brand-title {
      font-size: 22px;
      font-weight: 800;
      color: #111827;
      letter-spacing: -0.02em;
      margin-bottom: 4px;
    }

    .brand-contact {
      font-size: 12px;
      color: #4b5563;
    }

    .invoice-meta {
      text-align: right;
    }

    .invoice-heading {
      font-size: 26px;
      font-weight: 900;
      color: #111827;
      letter-spacing: 0.05em;
      line-height: 1;
      margin-bottom: 6px;
    }

    .invoice-number {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 13px;
      color: #4b5563;
      font-weight: 600;
    }

    /* Divider */
    .divider-thick {
      height: 2px;
      background: #111827;
      margin: 15px 0 25px 0;
    }

    .divider-thin {
      height: 1px;
      background: #e5e7eb;
      margin: 15px 0;
    }

    /* Details Grid (Two columns) */
    .details-grid {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 30px;
      gap: 30px;
    }

    .section-label {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 11px;
      font-weight: 700;
      color: #6b7280;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .billed-to {
      flex: 1;
    }

    .client-name {
      font-size: 14px;
      font-weight: 700;
      color: #111827;
      margin-bottom: 3px;
    }

    .client-company,
    .client-email,
    .client-phone {
      font-size: 12px;
      color: #4b5563;
      margin-bottom: 2px;
    }

    .invoice-info {
      flex: 1;
      text-align: right;
    }

    .info-row {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      font-size: 12px;
      margin-bottom: 4px;
    }

    .info-label {
      color: #4b5563;
    }

    .info-val {
      color: #111827;
      font-weight: 600;
    }

    .capitalize {
      text-transform: capitalize;
    }

    /* Line Items Table */
    .items-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 25px;
    }

    .items-table th {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 11px;
      font-weight: 700;
      color: #6b7280;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 10px 8px;
      border-bottom: 1px solid #d1d5db;
      text-align: left;
    }

    .items-table td {
      padding: 12px 8px;
      border-bottom: 1px solid #f3f4f6;
      font-size: 13px;
      color: #1f2937;
      vertical-align: middle;
    }

    .col-desc {
      width: 50%;
    }

    .col-qty {
      width: 15%;
      text-align: center;
    }

    .col-price {
      width: 17%;
      text-align: right;
    }

    .col-amount {
      width: 18%;
      text-align: right;
    }

    .mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    .font-semibold {
      font-weight: 600;
    }

    .text-center {
      text-align: center;
    }

    .text-right {
      text-align: right;
    }

    /* Totals Section */
    .totals-container {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 35px;
    }

    .totals-table {
      width: 280px;
    }

    .totals-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: #4b5563;
      padding: 4px 0;
    }

    .total-due-row {
      border-top: 2px solid #111827;
      margin-top: 6px;
      padding-top: 8px;
      color: #111827;
      font-size: 15px;
      font-weight: 800;
    }

    .total-due-num {
      font-size: 18px;
      font-weight: 800;
      color: #111827;
    }

    /* Footer Notes */
    .footer-notes {
      padding-top: 20px;
      border-top: 1px solid #e5e7eb;
      font-size: 12px;
      color: #6b7280;
      line-height: 1.6;
    }

    .footer-notes strong {
      color: #374151;
    }
  </style>
</head>
<body>
  <div class="invoice-container">
    <!-- Header -->
    <div class="invoice-header">
      <div class="brand-section">
        <h2 class="brand-title">{{ business.name || 'Business Name' }}</h2>
        <p class="brand-contact">{{ business.email || 'business@example.com' }} &nbsp;|&nbsp; {{ business.phone || '+91 9876543210' }}</p>
      </div>
      <div class="invoice-meta">
        <h1 class="invoice-heading">INVOICE</h1>
        <p class="invoice-number">{{ invoice.invoiceNumber || invoice.invoice_number || 'INV-0000' }}</p>
      </div>
    </div>

    <div class="divider-thick"></div>

    <!-- Details Grid -->
    <div class="details-grid">
      <!-- Billed To -->
      <div class="billed-to">
        <div class="section-label">BILLED TO</div>
        <p class="client-name">{{ client.name || 'Valued Client' }}</p>
        @if(client.companyName || client.company_name)
          <p class="client-company">{{ client.companyName || client.company_name }}</p>
        @endif
        @if(client.email)
          <p class="client-email">{{ client.email }}</p>
        @endif
        @if(client.phone)
          <p class="client-phone">{{ client.phone }}</p>
        @endif
      </div>

      <!-- Invoice Details -->
      <div class="invoice-info">
        <div class="section-label">INVOICE DETAILS</div>
        <div class="info-row">
          <span class="info-label">Issue date:</span>
          <span class="info-val">{{ invoice.issueDate || invoice.createdAtFormatted || '—' }}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Due date:</span>
          <span class="info-val">{{ invoice.dueDateFormatted || invoice.dueDate || invoice.due_date || '—' }}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Status:</span>
          <span class="info-val capitalize">{{ invoice.status || 'draft' }}</span>
        </div>
      </div>
    </div>

    <!-- Line Items Table -->
    <table class="items-table">
      <thead>
        <tr>
          <th class="col-desc">DESCRIPTION</th>
          <th class="col-qty">QTY</th>
          <th class="col-price">UNIT PRICE</th>
          <th class="col-amount">AMOUNT</th>
        </tr>
      </thead>
      <tbody>
        @each(item in lineItems)
          <tr>
            <td class="col-desc">{{ item.description }}</td>
            <td class="col-qty mono">{{ item.quantity }}</td>
            <td class="col-price mono">₹{{ item.unitPriceFormatted || item.unitPrice || item.unit_price }}</td>
            <td class="col-amount mono font-semibold">₹{{ item.amountFormatted || item.amount }}</td>
          </tr>
        @endeach
      </tbody>
    </table>

    <!-- Totals Section -->
    <div class="totals-container">
      <div class="totals-table">
        <div class="totals-row">
          <span>Subtotal</span>
          <span class="mono">₹{{ invoice.totalAmountFormatted || invoice.totalAmount || invoice.total_amount || '0.00' }}</span>
        </div>
        <div class="totals-row">
          <span>Tax (0%)</span>
          <span class="mono">₹0.00</span>
        </div>
        <div class="totals-row total-due-row">
          <span>Total Due</span>
          <span class="mono total-due-num">₹{{ invoice.totalAmountFormatted || invoice.totalAmount || invoice.total_amount || '0.00' }}</span>
        </div>
      </div>
    </div>

    <!-- Footer Notes -->
    <div class="footer-notes">
      <p><strong>Note:</strong> {{ invoice.notes || 'Payment due within 15 days of receipt. Thank you for your business.' }}</p>
    </div>
  </div>
</body>
</html>
